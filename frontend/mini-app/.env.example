# API base URL. Leave empty / unset in dev to use the Vite /api proxy
# (http://localhost:3000). In production set the full backend origin, e.g.
# VITE_API_URL=https://api.example.com/api
VITE_API_URL=
# Fallback bot username used for referral links when GET /api/telegram/config
# is unavailable. The config endpoint is preferred when the backend provides it.
VITE_BOT_USERNAME=
VITE_TELEGRAM_BOT_USERNAME=
