# Backend base URL INCLUDING the /api prefix — the landing fetches
# {VITE_API_URL}/telegram/config for the bot username + Mini App URL.
# Leave empty to skip the fetch and rely on VITE_BOT_USERNAME only.
VITE_API_URL=https://your-backend-url.com/api
# Fallback Telegram bot username (without @), used when the backend
# config endpoint is unavailable.
VITE_BOT_USERNAME=your_bot_username
