FROM node:22-alpine AS builder

WORKDIR /app

# Build context is frontend/ so the shared design system (frontend/shared,
# imported as @shared) is available at ../shared relative to the app.
COPY shared ./shared
COPY user-portal/package*.json ./user-portal/
WORKDIR /app/user-portal
# Lockfiles are generated on glibc hosts; the Alpine (musl) builder hits the
# npm optional-deps bug (npm/cli#4828) and misses @rollup/rollup-linux-x64-musl.
# Resolve fresh inside the image instead (matches the pre-lockfile deploys).
RUN rm -f package-lock.json && npm install --no-audit --no-fund

COPY user-portal/ ./

# Vite reads VITE_* at build time — pass via compose build args
ARG VITE_API_URL=https://api.tradingbeast.ecomex.cloud/api
ARG VITE_BOT_USERNAME=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BOT_USERNAME=$VITE_BOT_USERNAME

RUN node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build

FROM nginx:alpine AS runner

COPY --from=builder /app/user-portal/dist /usr/share/nginx/html
COPY user-portal/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
