[Unit]
Description=Session Focus Radar User Portal
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=sfr
WorkingDirectory=/opt/session-focus-radar
ExecStart=/usr/bin/docker compose up user-frontend
ExecStop=/usr/bin/docker compose stop user-frontend
Restart=always
RestartSec=10
Environment=COMPOSE_PROJECT_NAME=sfr

# Resource limits
MemoryLimit=512M
CPUQuota=25%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sfr-user-frontend

[Install]
WantedBy=multi-user.target