# Session Focus Radar - Production Environment
# Copy to .env on VPS and fill in all values

# Database (PostgreSQL in Docker)
DATABASE_URL=postgresql://postgres:SecurePass123!@postgres:5432/session_focus_radar?schema=public

# JWT Secret - Generate with: openssl rand -base64 48
JWT_SECRET=supersecretjwtkeychangeinproductionmin32chars

# Telegram Bot
TELEGRAM_BOT_TOKEN=9002534984:AAFPskjZ_nXxDZ4uu_RrBrbUpEszIV3Z09w
TELEGRAM_BOT_USERNAME=tradingbeastbyjunaitbot

# Frontend URLs (update with your domain)
FRONTEND_URL=https://tradingbeast.ecomex.cloud
ADMIN_FRONTEND_URL=https://admin.tradingbeast.ecomex.cloud

# Server
PORT=3000
NODE_ENV=production

# External APIs (optional fallbacks for Yahoo Finance)
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# QuickChart (self-hosted in Docker)
QUICKCHART_URL=http://quickchart:3400

# Payment Configuration
# bKash/Nagad - Manual verification, update with your merchant numbers
BKASH_MERCHANT_NUMBER=+8801XXXXXXXXX
NAGAD_MERCHANT_NUMBER=+8801XXXXXXXXX

# USDT TRC20 - Auto-verified, update with your wallet address
USDT_TRC20_ADDRESS=TXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Monitoring (optional)
ALERT_WEBHOOK=

# SSL Email for Certbot
SSL_EMAIL=admin@tradingbeast.ecomex.cloud

# Feature Flags
ENABLE_CRYPTO=false
ENABLE_REFERRALS=true
ENABLE_DAILY_PUBLISHING=true

# Database password
POSTGRES_PASSWORD=SecurePass123!
